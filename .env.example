# Optional. The compose file carries these same defaults, so the stack starts
# without this file and copying it changes nothing until you edit a value.
#
# Put it in place BEFORE the first start. POSTGRES_PASSWORD is written into the
# database volume the first time Postgres runs, so changing it afterwards locks
# every service out with "password authentication failed". If that happens:
#
#     docker compose -f docker-compose.ghcr.yml down -v
#     docker compose -f docker-compose.ghcr.yml up -d
#
# which also throws away anything you published.

POSTGRES_DB=dashverse
POSTGRES_USER=dashverse
POSTGRES_PASSWORD=dashverse

# Need a strong value? https://randomkeygen.com/ or: openssl rand -base64 36
JWT_SECRET=workshop-jwt-secret-change-me-please-32chars
SUPERSET_SECRET_KEY=workshop-superset-secret-change-me-32chars

# You log in to Superset with this one.
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_READER_PASSWORD=dashverse

# Pin the EVERSE catalogue to a commit, or leave blank to track main.
INDICATORS_REF=

# Load the project's sample assessments after provisioning.
SEED_DATA=true
