# Optional. The compose file carries defaults, so it starts without this
# file. Copy it to .env only if you want to override something.

POSTGRES_DB=dashverse
POSTGRES_USER=dashverse
POSTGRES_PASSWORD=changeme

# Need a strong value? https://randomkeygen.com/ or: openssl rand -base64 36
JWT_SECRET=changeme-at-least-32-characters-long-secret
SUPERSET_SECRET_KEY=changeme-at-least-32-characters-long-secret
SUPERSET_ADMIN_PASSWORD=changeme
SUPERSET_READER_PASSWORD=changeme

# Pin the EVERSE catalogue to a commit, or leave blank to track main.
INDICATORS_REF=

# Load the project's sample assessments after provisioning.
SEED_DATA=true
